{
  "name": "snappy-prerender",
  "version": "2.12.2",
  "description": "Install the maintained react-snap alternative: MIT drop-in static prerendering for React, Vue, Svelte, Preact, Angular, Solid, Lit, Ember and vanilla SPAs, including Vite builds. Playwright, hydration checks and AI-crawler-friendly output.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "sayakmukherjee080",
    "url": "https://github.com/sayakmukherjee080"
  },
  "homepage": "https://github.com/sayakmukherjee080/snappy-prerender#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayakmukherjee080/snappy-prerender.git"
  },
  "bugs": {
    "url": "https://github.com/sayakmukherjee080/snappy-prerender/issues"
  },
  "keywords": [
    "react-snap",
    "react-snap-alternative",
    "react-snap-replacement",
    "prerender",
    "prerendering",
    "spa",
    "spa-prerender",
    "react-prerender",
    "vite-prerender",
    "static-site",
    "static-html",
    "react",
    "vue",
    "svelte",
    "preact",
    "angular",
    "solid",
    "solidjs",
    "lit",
    "ember",
    "vanilla-js",
    "framework-agnostic",
    "vite",
    "create-react-app",
    "cra",
    "seo",
    "javascript-seo",
    "hydration",
    "playwright",
    "ai-crawlers",
    "llm-seo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core/index.js",
    "./head": "./src/head/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "snappy-prerender": "src/cli.js"
  },
  "files": [
    "src",
    "assets",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "./src/head/manager.js"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs tests/unit",
    "test:integration": "node scripts/run-tests.mjs tests/integration",
    "benchmark": "node scripts/benchmark.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "npm run lint && npm test && npm run test:integration"
  },
  "dependencies": {
    "@puppeteer/browsers": "3.2.3",
    "clean-css": "5.3.3",
    "html-minifier-terser": "7.2.0",
    "parse5": "8.0.0",
    "playwright-core": "1.63.0",
    "sirv": "3.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@vitejs/plugin-react": "5.0.0",
    "beasties": "0.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "7.3.7"
  },
  "workspaces": [
    "tests/fixtures/react16-app",
    "tests/fixtures/react17-app",
    "tests/fixtures/react18-app"
  ],
  "peerDependencies": {
    "beasties": ">=0.4.1",
    "react": ">=16.8.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "beasties": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
